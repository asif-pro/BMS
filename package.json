{
  "name": "Bus-Management-System",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3001 --mode localdev",
    "build": "npm run lint && tsc -b && vite build",
    "build:stg": "tsc -b && vite build --mode stg",
    "build:qa": "tsc -b && vite build --mode qa",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "preview": "vite preview --port=4173",
    "preview:stg": "vite preview --port=3002",
    "test": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
