    "react": "^19.1.0",
    "react-apexcharts": "^1.9.0",
    "react-cookie": "^7.2.2",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "react-i18next": "^14.1.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.2.0",
    "react-window": "^1.8.11",
    "simplebar-react": "^3.3.0",
    "uuid": "^9.0.1"
